# Copy this file to .env on the deployment host and keep the real file private.
# Point public DNS at the deployment host before starting Caddy.
C_LINK_DOMAIN=api.example.com

# The model server must be reachable over a private network. Do not expose its
# unauthenticated llama.cpp port publicly.
C_LINK_LLAMACPP_URL=https://model.internal.example/v1
# Optional override if that upstream expects a different model ID.
C_LINK_UPSTREAM_MODEL_NAME=local-model
C_LINK_MODEL_NAME=local-model
# Create secrets/llamacpp_api_key with the provider's API key; leave it empty
# only when the model endpoint is already protected by a private network.

# Limits apply per tenant. C-Link runs as a single API instance in this stack.
C_LINK_TENANT_REQUESTS_PER_MINUTE=60
C_LINK_MAX_CONCURRENT_GENERATIONS=1
C_LINK_MAX_OUTPUT_TOKENS=4096
C_LINK_MAX_REQUEST_BYTES=2097152
C_LINK_PROVIDER_TIMEOUT_SECONDS=180
